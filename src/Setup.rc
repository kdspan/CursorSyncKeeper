#include <winres.h>
#include "resource.h"

// Application icon embedded into the executable (Explorer / taskbar).
IDI_APP_ICON ICON "appicon.ico"

// Self-contained payloads: the daemon + control panel are embedded as binary
// resources inside Setup.exe, so the installer is a single standalone file.
IDR_DAEMON_BIN RCDATA "CursorSyncKeeper.exe"
IDR_PANEL_BIN  RCDATA "CursorSyncKeeperPanel.exe"

// NOTE: rc.exe is ANSI-only and cannot handle the UTF-8 Chinese UI strings, so
// every visible label is set from C++ (Setup.cpp) at runtime. The English
// strings below are just placeholders that get overwritten immediately.

IDD_WIZARD DIALOGEX 12, 12, 460, 340
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "CursorSyncKeeper Setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_WIZ_TITLE, 16, 14, 428, 20
    LTEXT           "", IDC_W0_TEXT,   16, 44, 428, 220
    LTEXT           "", IDC_W1_PROMPT, 16, 50, 428, 20
    EDITTEXT        IDC_PATH,          16, 76, 360, 24, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse", IDC_BROWSE, 388, 76, 56, 24
    LTEXT           "", IDC_W2_TEXT,   16, 44, 428, 220
    LTEXT           "", IDC_W3_TEXT,   16, 44, 428, 220
    PUSHBUTTON      "Cancel", IDC_CANCEL, 16,  300, 80, 30
    PUSHBUTTON      "Back",   IDC_BACK,   300, 300, 72, 30
    DEFPUSHBUTTON   "Next",   IDC_NEXT,   380, 300, 72, 30
END
